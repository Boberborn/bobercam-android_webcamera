<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
		<Nullable>enable</Nullable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<EnableComHosting>true</EnableComHosting>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Platforms>x64;x86;ARM64</Platforms>
		<AssemblyName>BobrCam.VirtualCameraSource</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\VCamNetSample\Properties\AssemblyVersionInfo.cs" Link="Properties\AssemblyVersionInfo.cs" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="DirectNCore" Version="1.16.1.2" />
	  <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\..\BobrCam\libs\*.dll"
	        Link="libs\%(Filename)%(Extension)"
	        CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
